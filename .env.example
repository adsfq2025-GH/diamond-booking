# ============================================================
# Diamond Booking — environment variables
# Copy to .env.local and fill in. Never commit real values.
# ============================================================

# ---------- App ----------
# Public origin of this app (used for redirects, Stripe return URLs, widget embed snippet)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Super admin (platform owner) ----------
# Set these, then visit {APP_URL}/api/admin/setup once to provision the
# super-admin account. Sign in at /login with these to reach /admin.
# Change the password and re-visit the URL to rotate it. Use a STRONG password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---------- Supabase ----------
# Dashboard -> Project Settings -> API (or `supabase start` output for local dev)
# Project URL, e.g. https://abcdefgh.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# anon/public key — safe to expose to the browser; RLS is the guard
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — BYPASSES RLS. Server-side only (webhooks, onboarding, admin jobs). NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe ----------
# Dashboard -> Developers -> API keys
# Secret key (sk_test_... / sk_live_...) — server-side only
STRIPE_SECRET_KEY=
# Publishable key (pk_test_... / pk_live_...) — used by Stripe.js in the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) from Dashboard -> Developers -> Webhooks
# (or `stripe listen --forward-to localhost:3000/api/webhooks/stripe` for local dev)
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (price_...) for the three subscription tiers
# Create one monthly recurring Price per tier in Dashboard -> Product catalog
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ELITE=

# ---------- Email ----------
# Two ways to send booking emails (checked per booking: tenant SMTP first, then Resend):
#
# 1. Each business can connect their OWN email via SMTP in the app
#    (Settings -> Integrations -> Email delivery). No env vars needed for that.
#
# 2. Platform-wide SMTP — YOUR OWN mail server as the default sender for
#    everyone. Takes priority over Resend. (For Gmail: smtp.gmail.com / 587 /
#    an App Password.) Leave SMTP_SECURE=true only for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "Diamond Booking <notifications@yourdomain.com>"
SMTP_FROM=
#
# 3. Platform-wide Resend as a fallback sender for everyone:
# https://resend.com -> API Keys (re_...)
RESEND_API_KEY=
# Verified sender, e.g. "Diamond Booking <notifications@yourdomain.com>"
RESEND_FROM_EMAIL=

# ---------- Twilio (SMS reminders — professional/elite plans) ----------
# Console -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Purchased phone number in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=
