# ============================================================
# Diamond Booking — environment variables
# Copy to .env.local and fill in. Never commit real values.
# ============================================================

# ---------- App ----------
# Public origin of this app (used for redirects, Stripe return URLs, widget embed snippet)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Super admin (platform owner) ----------
# Set these, then call {APP_URL}/api/admin/setup ONCE to provision the
# super-admin account. Sign in at /login with these to reach /admin.
# Change the password and call it again to rotate it. Use a STRONG password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# REQUIRED to enable /api/admin/setup at all — without it the route returns 404
# to everyone. Set a long random string, call the route once with it, then
# REMOVE this variable again:
#   curl -X POST "{APP_URL}/api/admin/setup" -H "x-setup-token: <token>"
SUPER_ADMIN_SETUP_TOKEN=

# ---------- Cron (REQUIRED) ----------
# Two scheduled jobs (see vercel.json):
#   /api/cron/extend-recurring  07:00 daily — tops up open-ended recurring series
#   /api/cron/send-reminders    every 15m   — dispatches due booking reminders
# Both REQUIRE this value and return 401 without it, so reminders simply never
# send if it is unset. Set a long random string; Vercel Cron sends it as a
# Bearer token so only the scheduler can trigger the jobs.
CRON_SECRET=

# ---------- OAuth state signing (optional) ----------
# HMAC key for the signed `state` on the Google Calendar OAuth round-trip.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset; set it explicitly if you
# would rather not reuse that key for signing.
OAUTH_STATE_SECRET=

# ---------- Placeholder / preview mode (optional, NOT for production) ----------
# Without real Supabase keys the app degrades to an unauthenticated demo: route
# protection is skipped and bookings are synthesized without being stored. That
# is automatic in development. In production the app refuses to serve (503)
# unless you opt in here deliberately.
ALLOW_PLACEHOLDER_MODE=

# ---------- Supabase ----------
# Dashboard -> Project Settings -> API (or `supabase start` output for local dev)
# Project URL, e.g. https://abcdefgh.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# anon/public key — safe to expose to the browser; RLS is the guard
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — BYPASSES RLS. Server-side only (webhooks, onboarding, admin jobs). NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe ----------
# Dashboard -> Developers -> API keys
# Secret key (sk_test_... / sk_live_...) — server-side only
STRIPE_SECRET_KEY=
# Publishable key (pk_test_... / pk_live_...) — used by Stripe.js in the browser.
# MUST be the NEXT_PUBLIC_ name: Next.js only exposes prefixed vars to the client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Online DEPOSIT CAPTURE at booking time. Leave unset/false.
# The booking flow does not yet collect a card: there is no Stripe.js, no
# Elements and no confirmation step. With this off, no PaymentIntent is created
# and the customer is told plainly that nothing was charged and the business
# will arrange the deposit — which is true. Setting it to true before that UI
# exists only produces abandoned intents in your Stripe dashboard.
STRIPE_DEPOSIT_CAPTURE_ENABLED=false
# Webhook signing secret (whsec_...) from Dashboard -> Developers -> Webhooks
# (or `stripe listen --forward-to localhost:3000/api/webhooks/stripe` for local dev)
STRIPE_WEBHOOK_SECRET=
# Stripe Connect for tenant payouts / online payments
# Reuses the same Stripe platform account and secret key above.
# Recurring Price IDs (price_...) per tier and billing period.
# These EXACT names are what src/lib/plans.ts reads — a _MONTHLY or
# _PRO/_ENTERPRISE variant will not be found and every upgrade will fail.
# The tiers are starter / professional / elite; there is no "Enterprise" tier.
#
# Monthly is REQUIRED (unsuffixed). The amount on each Price must equal the
# priceMonthly in lib/plans.ts: the admin System health tab fetches both and
# reports a blocker if they differ, because that means a customer would be
# billed an amount the page never showed.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ELITE=
#
# Yearly is OPTIONAL. Set all three and the monthly/yearly switch appears in
# Settings -> Billing; leave any unset and only monthly is offered. Each must
# be a year-interval Price whose amount equals priceYearly in lib/plans.ts
# (checkout re-verifies the interval before sending anyone to pay).
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=
STRIPE_PRICE_ELITE_YEARLY=

# ---------- Google Calendar ----------
# OAuth app credentials for staff calendar connection flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email ----------
# Two ways to send booking emails (checked per booking: tenant SMTP first, then Resend):
#
# 1. Each business can connect their OWN email via SMTP in the app
#    (Settings -> Integrations -> Email delivery). No env vars needed for that.
#
# 2. Platform-wide SMTP — YOUR OWN mail server as the default sender for
#    everyone. Takes priority over Resend. (For Gmail: smtp.gmail.com / 587 /
#    an App Password.) Leave SMTP_SECURE=true only for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "Diamond Booking <notifications@yourdomain.com>"
SMTP_FROM=
#
# 3. Platform-wide Resend as a fallback sender for everyone:
# https://resend.com -> API Keys (re_...)
RESEND_API_KEY=
# Verified sender, e.g. "Diamond Booking <notifications@yourdomain.com>"
RESEND_FROM_EMAIL=

# ---------- Twilio (SMS reminders — professional/elite plans) ----------
# Console -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Purchased phone number in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=
