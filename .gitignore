# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template (no secrets) IS committed so it documents every var
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Added by `vercel link`.
.vercel

# Real secrets never go in the repo...
.env*
# ...but the template that documents which variables exist must.
# `.env*` matches it, and a tracked file stays tracked, so this only
# bites when someone re-adds it or adds a second template — silently.
!.env.example
